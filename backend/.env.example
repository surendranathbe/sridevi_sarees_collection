# ==============================================================================
# Sridevi Sarees & Collections - Backend Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in this backend/ directory:
#    cp .env.example .env
# 2. Fill in the values below with your real configuration.
# 3. NEVER commit your actual .env file or real secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas SRV or standalone).
# Example: mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/sridevi_collections_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/sridevi_collections_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. HTTP Server Configuration
# ------------------------------------------------------------------------------
# Port the Spring Boot application listens on (default: 8080)
PORT=8080

# ------------------------------------------------------------------------------
# 3. CORS & Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins that may call this API.
# Development: http://localhost:5173
# Production: https://your-production-domain.vercel.app
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. JWT Authentication Security (REQUIRED)
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify HMAC-SHA JWT bearer tokens.
# MANDATORY REQUIREMENT: Must be at least 32 bytes (256 bits) in length.
# Application startup will abort immediately with an error if missing or too short.
# Generate a cryptographically secure key with: openssl rand -base64 32
JWT_SECRET=replace_with_a_cryptographically_secure_256_bit_secret_key_minimum_32_characters

# ------------------------------------------------------------------------------
# 5. Initial Admin Account Provisioning (OPTIONAL ON FIRST STARTUP)
# ------------------------------------------------------------------------------
# Only evaluated if no admin account exists in the database.
# Existing admin accounts are NEVER updated or overwritten on application startup.
# ADMIN_INITIAL_PASSWORD must be at least 12 characters long.
ADMIN_EMAIL=admin@sridevisarees.com
ADMIN_INITIAL_PASSWORD=replace_with_secure_initial_admin_password_min_12_chars
