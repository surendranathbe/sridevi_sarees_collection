# ==============================================================================
# Sridevi Sarees & Collections - Backend Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in this backend/ directory (or root directory):
#    cp .env.example .env
# 2. Replace the placeholders below with your actual MongoDB Atlas connection string.
# 3. NEVER commit the real .env file with credentials into git version control.
# ==============================================================================

# MongoDB Atlas Connection URI (Standard format with sridevi_collections_db)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/sridevi_collections_db?retryWrites=true&w=majority

# Target Database Name
MONGODB_DATABASE=sridevi_collections_db

# Backend Server Port (Default: 8080)
PORT=8080

# React Frontend Development Origin (For CORS configuration)
FRONTEND_URL=http://localhost:5173
