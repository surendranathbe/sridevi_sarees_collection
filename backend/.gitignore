
# ==============================================================================
# Sridevi Sarees & Collections - Git Ignore
# ==============================================================================

# Java / Maven compiled output
target/
**/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Node.js dependencies and build output
node_modules/
dist/
build/
coverage/
.npm/

# Environment variables and secrets (DO NOT COMMIT)
.env
.env.*
!.env.example
*.env
*.env.*
application-local.properties
application-secrets.properties
application-production.properties

# Logs
*.log
logs/

# Java runtime files
*.class
hs_err_pid*
replay_pid*

# Spring Boot generated files
.springBeans

# Spring Tool Suite / Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.sts4-userId

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.swp
*.swo
*~
